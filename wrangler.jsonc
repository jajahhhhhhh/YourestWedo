{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourestwedo",
  "account_id": "aed56ccedac8bafaa6cc2551eea1cefe",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Keep variables added in the Cloudflare dashboard when GitHub Actions deploys.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "PHOTOS", "class_name": "PhotoStore" },
      { "name": "JOBS", "class_name": "JobStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhotoStore"] },
    { "tag": "v2", "new_sqlite_classes": ["JobStore"] }
  ]
}
